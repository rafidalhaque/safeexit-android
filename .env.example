# SafeExit App Signing Configuration Template
# Copy this file to '.env' and fill in your details.
# DO NOT commit the actual '.env' file containing your passwords to version control.

# Keystore Password used to unlock and sign the release build via sign_apk.sh
KEYSTORE_PASSWORD="your_keystore_password_here"

# Telegram Notifications (optional)
# Set these to automatically upload the compiled APK to a Telegram channel/chat
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_channel_or_chat_id"

